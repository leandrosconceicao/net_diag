<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NetDiag.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI: capacidade da placa de rede (velocidade máxima, duplex, configuração manual) -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite testar o parser interno do netsh (NetshParser) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NetDiag.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
