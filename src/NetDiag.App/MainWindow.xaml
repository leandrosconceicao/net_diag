<Window x:Class="NetDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetDiag — Diagnóstico de Conexão"
        Width="1040" Height="740" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Diagnóstico de Conexão" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Descubra por que a internet está lenta ou caindo — e onde está o problema."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Opções e ação principal -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                    <CheckBox Content="Incluir teste de velocidade (consome dados da internet)"
                              IsChecked="{Binding RunSpeedTest}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding RunSpeedTest}">
                        <TextBlock Text="Velocidade contratada (opcional):" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox Width="80" Margin="8,0" Padding="4,3" VerticalContentAlignment="Center"
                                 Text="{Binding ContractedSpeedText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Mbps" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Diagnosticar" Style="{StaticResource PrimaryButton}" FontSize="16"
                            Command="{Binding RunCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corpo -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Etapas -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Etapas" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ProgressBar DockPanel.Dock="Top" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,14"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource LineBrush}" BorderThickness="0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Segoe UI Symbol" FontSize="16"
                                                   Text="{Binding State, Converter={StaticResource StepGlyph}}"
                                                   Foreground="{Binding State, Converter={StaticResource StepBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Resultado -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasReport, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding PlaceholderText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>

                    <!-- Veredito -->
                    <Border CornerRadius="10" Padding="18" Margin="0,0,0,12"
                            Background="{Binding Overall, Converter={StaticResource VerdictBrush}}"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding VerdictTitle}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VerdictText}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Conclusões -->
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" BorderThickness="5,1,1,1"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2"
                                                    Margin="12,0,0,0" VerticalAlignment="Top"
                                                    Background="{StaticResource BgBrush}">
                                                <TextBlock Text="{Binding Area}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                                            <Run Text="O que fazer: " FontWeight="SemiBold" /><Run Text="{Binding Recommendation, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding SeverityLabel, Mode=OneWay}" /><Run Text=" · confiança " /><Run Text="{Binding ConfidenceLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Detalhes técnicos -->
                    <Expander Header="Detalhes técnicos" Margin="0,4,0,0"
                              Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,8"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding Metrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Display, Mode=OneWay}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Rodapé -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copiar resumo" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CopySummaryCommand}" />
                <Button Content="Salvar relatório" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveReportCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
    </Grid>
</Window>
